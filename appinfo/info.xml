<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nc_litter</id>
	<name>NC Litter</name>
	<summary>Monitor and control your Whisker Litter-Robot 4 from Nextcloud</summary>
	<description><![CDATA[NC Litter — your litter valet. Start a clean cycle, empty the waste drawer, toggle sleep / night-light / panel-lock, and watch live waste-drawer and litter levels, cat weight, and cycle history for a Whisker Litter-Robot 4. Connects through a private bridge to your Whisker account; credentials are stored encrypted. Includes cycle history, cat-themed achievements, an error decoder, maintenance reminders, and Nextcloud Notifications/Activity.]]></description>
	<version>0.2.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="dan@19labs.com">19labs</author>
	<namespace>NcLitter</namespace>
	<category>tools</category>
	<website>https://github.com/vdroners/nc-litter</website>
	<bugs>https://github.com/vdroners/nc-litter/issues</bugs>
	<repository type="git">https://github.com/vdroners/nc-litter.git</repository>
	<documentation>https://github.com/vdroners/nc-litter/blob/main/docs/OPERATOR.md</documentation>
	<dependencies>
		<!-- No PHP upper bound, deliberately. A cap is re-validated by `occ upgrade`
		     on every app version bump; the Nextcloud image moved to PHP 8.5 while the
		     sibling vacuum app still declared 8.4, and its next bump failed its own
		     dependency check and put the WHOLE INSTANCE into maintenance mode. -->
		<php min-version="8.1"/>
		<database>sqlite</database>
		<database>mysql</database>
		<database>pgsql</database>
		<lib>curl</lib>
		<nextcloud min-version="28" max-version="34"/>
	</dependencies>
	<navigations>
		<navigation>
			<name>NC Litter</name>
			<route>nc_litter.page.index</route>
			<icon>app.svg</icon>
			<order>86</order>
		</navigation>
	</navigations>
	<activity>
		<settings>
			<setting>OCA\NcLitter\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\NcLitter\Activity\Provider</provider>
		</providers>
	</activity>
	<repair-steps>
		<post-migration>
			<step>OCA\NcLitter\Migration\PurgeFabricatedCyclesRepairStep</step>
		</post-migration>
	</repair-steps>
	<background-jobs>
		<job>OCA\NcLitter\BackgroundJob\TelemetrySampleJob</job>
		<job>OCA\NcLitter\BackgroundJob\RetentionPruneJob</job>
	</background-jobs>
	<settings>
		<admin-section>OCA\NcLitter\Settings\AdminSection</admin-section>
		<admin>OCA\NcLitter\Settings\AdminSettings</admin>
	</settings>
</info>
