# Copy to `.env` and chmod 600. Never commit real values.
# Compose reads this for the bridge container (LITTER_MOCK=0 for a live unit).

LITTER_MOCK=1
WHISKER_EMAIL=
WHISKER_PASSWORD=
# Optional: bind a specific LR4 id/serial when the account has more than one.
LITTER_DEVICE_ID=
# Cloud poll cadence (seconds) when no live push is active.
LITTER_REFRESH_S=30
